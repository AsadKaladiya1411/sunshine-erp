{
  "name": "worker",
  "version": "1.0.0",
  "description": "Sunshine ERP background worker infrastructure",
  "main": "dist/index.js",
  "scripts": {
    "predev": "npm run build --workspace=@sunshine-erp/config --workspace=@sunshine-erp/messaging",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "prebuild": "npm run build --workspace=@sunshine-erp/config --workspace=@sunshine-erp/messaging",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=../../.env dist/index.js",
    "check-types": "tsc --noEmit",
    "pretest": "npm run build --workspace=@sunshine-erp/config --workspace=@sunshine-erp/messaging",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@sunshine-erp/config": "*",
    "@sunshine-erp/messaging": "*",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@sunshine-erp/typescript-config": "*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
}
