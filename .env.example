NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sunshine_erp

# HTTP security foundation
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
REQUEST_BODY_LIMIT_BYTES=1048576

# Authentication foundation. Replace both development secrets in deployed
# environments and manage deployed values through secret configuration.
JWT_ISSUER=sunshine-erp-api
JWT_AUDIENCE=sunshine-erp
JWT_SECRET=development-only-jwt-secret-change-before-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=900
REFRESH_TOKEN_LIFETIME_SECONDS=604800
REFRESH_TOKEN_DIGEST_SECRET=development-only-refresh-digest-secret-change-before-production
PASSWORD_MIN_LENGTH=12
BCRYPT_COST=12
PASSWORD_HISTORY_DEPTH=5
ACCOUNT_LOCK_FAILED_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MS=900000
DEFAULT_MAX_CONCURRENT_SESSIONS=5
REFRESH_COOKIE_NAME=sunshine_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=strict
REFRESH_COOKIE_PATH=/api/v1/auth
PASSWORD_RESET_TOKEN_LIFETIME_SECONDS=1800

# Redis/cache infrastructure. Redis remains disposable infrastructure and is
# not authoritative for ERP transactional data.
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_KEY_PREFIX=sunshine

# Reserved for later foundation passes; optional until each service is implemented.
KAFKA_BROKERS=localhost:9092

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio123
STORAGE_BUCKET=sunshine-erp

LOG_LEVEL=info
